# Copy to .env and adjust. Docker Compose reads .env automatically.
# Running locally with ./mvnw needs none of this: the default `dev` profile
# uses in-memory H2 and no external services.

# ---------------------------------------------------------------------------
# Profile
# ---------------------------------------------------------------------------
# dev  - in-memory H2, H2 console on, no external dependencies (default)
# prod - PostgreSQL; DB_USERNAME and DB_PASSWORD are required and have no fallback
SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
SERVER_PORT=8080

# ---------------------------------------------------------------------------
# Database (prod profile only)
# ---------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/user_task_reminder
DB_USERNAME=utr
DB_PASSWORD=change-me
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2

# Used by the postgres service in docker-compose.yml.
POSTGRES_DB=user_task_reminder
POSTGRES_USER=utr
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
# Set false to run the API with no schedulers at all.
SCHEDULER_ENABLED=true
# Reminder poll: how long after startup the first sweep runs, and the gap between sweeps.
REMINDER_INITIAL_DELAY_MS=10000
REMINDER_POLL_INTERVAL_MS=30000
# Overdue task sweep.
OVERDUE_INITIAL_DELAY_MS=20000
OVERDUE_POLL_INTERVAL_MS=300000
# Notification delivery retries.
DELIVERY_RETRY_INITIAL_DELAY_MS=30000
DELIVERY_RETRY_INTERVAL_MS=120000

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# Channel used when a notification or reminder does not name one: WEB, EMAIL, SMS or PUSH.
# Only WEB and EMAIL have senders; anything else is recorded as ABANDONED.
NOTIFICATIONS_DEFAULT_CHANNEL=WEB
# Delivery attempts before a notification is abandoned.
NOTIFICATIONS_MAX_DELIVERY_ATTEMPTS=3
# The email sender is only registered when this is true.
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_EMAIL_FROM=no-reply@user-task-reminder.local
NOTIFICATIONS_EMAIL_SUBJECT_PREFIX=[Task Reminder]

# ---------------------------------------------------------------------------
# SMTP (only used when NOTIFICATIONS_EMAIL_ENABLED=true)
# ---------------------------------------------------------------------------
# Docker Compose points these at MailHog; its web UI is on port 8025.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ---------------------------------------------------------------------------
# Logging and diagnostics
# ---------------------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
# Logs every SQL statement Hibernate issues. Noisy; for debugging only.
JPA_SHOW_SQL=false
